{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Velox",
  "mainBinaryName": "Velox",
  "version": "../package.json",
  "identifier": "com.k4nes.velox",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velox",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "resizable": true,
        "center": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": ["'self'", "'unsafe-inline'"],
        "font-src": "'self'",
        "img-src": [
          "'self'",
          "data:",
          "https://api.iconify.design",
          "https://*.seadn.io"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://api.opensea.io",
          "https://api.relay.link",
          "https://ethereum-rpc.publicnode.com",
          "https://rpc.mainnet.chain.robinhood.com",
          "https://mainnet.base.org",
          "https://rpc.apechain.com/http",
          "https://robinhoodchain.blockscout.com",
          "https://*.alchemy.com",
          "https://rpc.ankr.com",
          "https://*.seadn.io"
        ],
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Velox",
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDM0JBOUQzRkM4Qjk5NEQKUldSTm1ZdjgwNms3bk5OVjhKdi9mWTQyaU9Sdm9JbS9MSjFhemsrSWx0R0dGOFJ1c1Zydmo3b0sK",
      "endpoints": ["https://github.com/K4nes/Velox/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" },
      "requireSignedVersion": true
    }
  }
}
