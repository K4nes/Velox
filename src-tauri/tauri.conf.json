{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Velox",
  "mainBinaryName": "Velox",
  "version": "../package.json",
  "identifier": "com.velox.console",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Velox",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Velox",
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
