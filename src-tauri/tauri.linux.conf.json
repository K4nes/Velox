{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBundleCommand": "node scripts/linux-desktop.mjs"
  },
  "bundle": {
    "targets": ["appimage"],
    "category": "Finance",
    "shortDescription": "NFT Desktop App Console",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/applications/Velox.desktop": "target/linux/Velox.desktop",
          "/usr/share/metainfo/com.k4nes.velox.metainfo.xml": "target/linux/com.k4nes.velox.metainfo.xml",
          "/usr/share/icons/hicolor/index.theme": "linux/hicolor-index.theme"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/K4nes/Velox/releases/latest/download/latest-linux.json"
      ]
    }
  }
}
