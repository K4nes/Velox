{
  "name": "velox",
  "private": true,
  "license": "MIT",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-local-tools.mjs && tsc -b && vite build",
    "typecheck": "node scripts/check-local-tools.mjs && tsc -b",
    "typecheck:test": "node scripts/check-local-tools.mjs && tsc -p tsconfig.test.json",
    "build:desktop": "tauri build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "node scripts/check-local-tools.mjs && e2e run",
    "test:e2e:live": "node scripts/check-live-env.mjs && node --env-file-if-exists=.env.e2e.local node_modules/e2e/dist/cli/bin.js run --config e2e.live.config.ts tests/wallet-profiles/live/balance.e2e.ts tests/eligibility/live tests/pnl/live tests/portfolio/live",
    "test:e2e:mint": "node scripts/check-live-env.mjs mint && node --env-file-if-exists=.env.e2e.local node_modules/e2e/dist/cli/bin.js run --config e2e.live.config.ts tests/mint/live",
    "release:desktop": "node scripts/release-desktop.mjs",
    "release:linux": "node scripts/release-linux.mjs",
    "release:verify": "node scripts/release-desktop.mjs --verify-only",
    "test:release": "node --test scripts/",
    "verify": "node scripts/check-upstream-drift.mjs && node scripts/check-command-table.mjs && node scripts/check-version-literal.mjs && node scripts/check-collection-label.mjs && node scripts/check-lockfile.mjs && node scripts/check-workflow-secrets.mjs && node scripts/check-workflow-width.mjs && npm run build && npm run typecheck:test && npm run lint && npm run test:release && npm run test:e2e"
  },
  "dependencies": {
    "@animate-ui/react": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.16.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "e2e": "^0.23.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
